VITE_SITE_SCOPE=development
VITE_ACADEMY_URL=http://localhost:7000

# ─── Auth local: el link de confirmacion de correo vuelve a este dev server ───
# Debe estar en Redirect URLs de Supabase (Authentication -> URL Configuration).
VITE_APP_URL=http://localhost:4100

# ─── Tienda / carrito de cliente (páginas de 10-qawaylab-inventario) ───
# La web principal sirve el carrito y el checkout; sin este interruptor el
# panel de pago no se renderiza (siteConfig.cart.enabled === false).
VITE_CART_ENABLED=true
