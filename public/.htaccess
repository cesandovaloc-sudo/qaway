# Qaway Lab - Fallback SPA cuando el DocumentRoot es dist/
DirectoryIndex index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# 1. Si el archivo existe fisicamente (js, css, imagenes, etc.), servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Fallback SPA para todas las rutas virtuales y articulos de Supabase
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
