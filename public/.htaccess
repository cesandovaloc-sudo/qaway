# Qaway Lab - Fallback SPA cuando el DocumentRoot es dist/
DirectoryIndex index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# 1. Si el archivo existe fisicamente (js, css, imagenes, etc.), servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Si es una ruta prerenderizada con su propio index.html, servirlo como archivo
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 3. Fallback SPA para todas las rutas virtuales y articulos dinamicos
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . /index.html [L]
