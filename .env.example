# ─── Web (Supabase propio: leads, briefs, formularios) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Academy (cliente SEPARADO, solo lectura del catálogo público) ───
VITE_ACADEMY_SUPABASE_URL=
VITE_ACADEMY_SUPABASE_ANON_KEY=

# URL base pública de Academy (enlaces de tarjetas: {VITE_ACADEMY_URL}/cursos/{slug})
VITE_ACADEMY_URL=

# URL base pública de assets/imágenes del catálogo (mapeo de PUBLIC_ASSETS_URL, v3 §39.1)
# Si imageUrl es relativa, se resuelve contra esta URL estable. En producción: https://academy.qawaylab.com o CDN.
VITE_PUBLIC_ASSETS_URL=
