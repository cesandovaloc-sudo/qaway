# Qaway Lab - Configuracion Estructural y Segura para Hostinger
DirectoryIndex dist/index.html index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# ==============================================================================
# 1. SEGURIDAD: Bloquear acceso a codigo fuente, dependencias y archivos sensibles
# ==============================================================================
RewriteRule ^(\.git|\.env|src|node_modules|docs|\.agents)(\/.*)?$ - [F,L,NC]
RewriteRule ^(package\.json|package-lock\.json|tsconfig\.json|vite\.config\.js|README\.md)$ - [F,L,NC]

# ==============================================================================
# 2. ARCHIVOS ESTATICOS REALES: Servir activos fisicos desde dist/
# ==============================================================================
# Si el archivo existe fisicamente dentro de dist/ (js, css, png, jpg, webp, svg, ico, etc.)
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.*)$ dist/$1 [L]

# ==============================================================================
# 3. ARTICULOS PRERENDERIZADOS: Servir su index.html directamente (como ARCHIVO -f)
# ==============================================================================
# Esto evita que mod_dir emita redirecciones 301 o inyecte /dist/ en la URL.
RewriteCond %{DOCUMENT_ROOT}/dist/$1/index.html -f
RewriteRule ^(.*)$ dist/$1/index.html [L]

# ==============================================================================
# 4. FALLBACK SPA: Rutas virtuales de React Router y nuevos articulos de Supabase
# ==============================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . dist/index.html [L]

# ==============================================================================
# 5. RENDIMIENTO: Compresion gzip y encabezados de cache
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
