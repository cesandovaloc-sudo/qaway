# Qaway Lab - Configuracion Estructural y Segura para Hostinger
DirectoryIndex dist/index.html index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# ==============================================================================
# 1. SEGURIDAD: Bloquear acceso a codigo fuente, dependencias y archivos sensibles
# ==============================================================================
RewriteRule ^(\.git|\.env|src|node_modules|docs|\.agents)(\/.*)?$ - [F,L,NC]
RewriteRule ^(package\.json|package-lock\.json|tsconfig\.json|vite\.config\.js|README\.md)$ - [F,L,NC]

# ==============================================================================
# 2. ARCHIVOS ESTATICOS REALES: Servir activos fisicos desde dist/
# ==============================================================================
# Si el archivo existe fisicamente dentro de dist/ (js, css, png, jpg, webp, svg, ico, etc.)
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.*)$ dist/$1 [L]

# ==============================================================================
# 2b. RUTAS PRERENDERIZADAS: Carpetas con su propio index.html (Open Graph)
# ==============================================================================
# /blog/articulo/<slug>, /landings/<slug>, etc. generados por
# scripts/prerender-articles.mjs. El test de la regla 2 es "-f" (archivo), y una
# ruta prerenderizada es un DIRECTORIO: sin esta regla el bot de Facebook/WhatsApp
# cae al fallback SPA y recibe la home generica en lugar del articulo.
# Mismo test que usa la regla 2 (backreference $1 del patron de la RewriteRule).
RewriteCond %{DOCUMENT_ROOT}/dist/$1/index.html -f
RewriteRule ^(.+?)/?$ dist/$1/index.html [L]

# ==============================================================================
# 3. FALLBACK SPA: Rutas virtuales de React Router y articulos de Supabase
# ==============================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . dist/index.html [L]

# ==============================================================================
# 4. RENDIMIENTO: Compresion gzip y encabezados de cache
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
