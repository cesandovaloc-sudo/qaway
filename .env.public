VITE_SITE_SCOPE=public
VITE_ACADEMY_URL=https://academy.qawaylab.com

# ─── Auth: dominio canonico para emailRedirectTo / OAuth / reset ───
# APP_BASE_URL en supabaseClient.ts. Debe coincidir EXACTO con la Site URL de
# Supabase (Authentication -> URL Configuration), sin barra final.
VITE_APP_URL=https://www.qawaylab.com

# ─── Tienda / carrito de cliente (páginas de 10-qawaylab-inventario) ───
# La web principal sirve el carrito y el checkout; sin este interruptor el
# panel de pago no se renderiza (siteConfig.cart.enabled === false).
VITE_CART_ENABLED=true
