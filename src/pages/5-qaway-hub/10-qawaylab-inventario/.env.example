[TEMPLATE]
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=
VITE_PUBLIC_APP_URL=http://localhost:9600

# Contacto público (catálogo /remates/:slug). Vacío = no se muestra el botón
VITE_PUBLIC_WHATSAPP=
VITE_PUBLIC_PHONE=

# App de carrito — módulo @qawaylab/pago (repo 3-qawaylab-pagos)
# VITE_CART_ENABLED=true activa carrito y checkout integrados
VITE_CART_ENABLED=
# VITE_CART_APP_URL (opcional si el checkout algún día es remoto)
VITE_CART_APP_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MERCADOPAGO_PUBLIC_KEY=

# AI Configuration (OpenAI Vision API)
VITE_OPENAI_API_KEY=
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions

# ─────────────────────────────────────────────────────────────
# Edge Function 'consulta-ruc-dni' (consulta SUNAT/RENIEC) —
# NO van en el frontend: se setean como secrets de la función:
#   supabase secrets set SUNAT_LOOKUP_API_TOKEN=xxx
# SUNAT_LOOKUP_API_BASE (opcional, default https://api.apis.net.pe/v2)
# ─────────────────────────────────────────────────────────────
