# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://josuepanaderia.pe

# Número de WhatsApp en formato internacional sin "+" ni espacios: 51 + número (9 dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=51987654321

# Ubicación dinámica
# URL personalizada de Google Maps (opcional). Si se deja vacía, se construye
# automáticamente a partir de la dirección configurada en data/site.ts
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Coordenadas del negocio para el schema LocalBusiness (latitud, longitud)
NEXT_PUBLIC_MAP_LAT=-12.0781
NEXT_PUBLIC_MAP_LNG=-77.0884
